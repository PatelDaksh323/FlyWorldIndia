# Flyworld India — environment variables
#
# ONLY VITE_-prefixed vars belong here. Everything VITE_* is bundled into the
# public browser JS, so it must contain NO secrets. The Supabase anon key is
# designed to be public and is protected by Row Level Security (see
# supabase/migrations/0001_create_enquiries.sql). Service-role / Gemini keys
# NEVER go here — they live in Supabase Edge Function secrets, server-side only.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Business contact details (public). Replace the placeholders below with the
# real values from Rahul before launch.
VITE_WHATSAPP_NUMBER=919999999999
VITE_PHONE_NUMBER=+919999999999
VITE_CONTACT_EMAIL=info@flyworldindia.com
